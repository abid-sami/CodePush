CREATE DATABASE SAMI6;
USE SAMI6;

CREATE TABLE Department(
	DeptID int,
	DeptName varchar(10),
)

CREATE TABLE Student(
	StudentID int,
	StudentName varchar(10),
	DeptID int,
	Age INT,
	CGPA float,
)

CREATE TABLE Enrollment(
	EnrollmentID int,
	StudentID int,
	CourseName varchar(20),
	Marks float,
)



