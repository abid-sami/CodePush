CREATE DATABASE SAMI5;
USE SAMI5;

CREATE TABLE Department(
	DeptID int PRIMARY KEY,
	DeptName varchar(10),
	
)

CREATE TABLE Student(
	SID int PRIMARY KEY,
	SName varchar(10),
	DeptID int,
	FOREIGN KEY(DeptID)
	REFERENCES Department(DeptID)
	ON DELETE CASCADE
	ON UPDATE CASCADE
)

INSERT INTO Department (DeptID, DeptName) VALUES
