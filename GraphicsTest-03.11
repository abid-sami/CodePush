#include <GL/glut.h>
#include <iostream>
#include <cstdlib>
using namespace std;

float posX = 0.0f, posY = 0.0f;

float moveStep = 0.1f;
float rWidth = 0.2f;
float rHeight = 0.2f;

void Rectangle()
{
    glColor3f(1, 0, 1);

    glBegin(GL_QUADS);
        glVertex2f(posX - rWidth, posY - rHeight);
        glVertex2f(posX + rWidth, posY - rHeight);
        glVertex2f(posX + rWidth, posY + rHeight);
        glVertex2f(posX - rWidth, posY + rHeight);
    glEnd();
}

void display()
{
    glClear(GL_COLOR_BUFFER_BIT);
    glLoadIdentity();
    Rectangle();
    glFlush();
}

void keyboard(unsigned char key, int x, int y)
{
    switch (key)
    {
        case 'w':
        case 'W':
            posY += moveStep;
            break;

        case 's':
        case 'S':
            posY -= moveStep;
            break;

        case 'a':
        case 'A':
            posX -= moveStep;
            break;

        case 'd':
        case 'D':
            posX += moveStep;
            break;

        case 27:
            exit(0);
    }

    glutPostRedisplay();
}

void init()
{
    glClearColor(1.0f, 1.0f, 1.0f, 1.0f);

    glMatrixMode(GL_PROJECTION);
    glLoadIdentity();
    gluOrtho2D(-1.0, 1.0, -1.0, 1.0);

    glMatrixMode(GL_MODELVIEW);
    glLoadIdentity();
}

int main(int argc, char** argv)
{
    glutInit(&argc, argv);
    glutInitDisplayMode(GLUT_SINGLE | GLUT_RGB);
    glutInitWindowSize(800, 600);

    glutCreateWindow("Rectangle Control with Keyboard");
    init();

    glutDisplayFunc(display);
    glutKeyboardFunc(keyboard);
    glutMainLoop();
}




